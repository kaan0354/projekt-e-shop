# WICHTIGE KONFIGURATION: MySQL-Datenbank
# Zugangsdaten an die verwendete Datenbank anpassen.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=webshop

# WICHTIGE KONFIGURATION: Backend
# Standard-Port für die lokale Entwicklung.
PORT=3000

# WICHTIGE KONFIGURATION: URLs
# Lokal können diese Werte so verwendet werden.
# Beim Hosting durch die echten Adressen ersetzen.
FRONTEND_URL=http://127.0.0.1:5500
BACKEND_URL=http://127.0.0.1:3000

# WICHTIGE KONFIGURATION: Session
# Eigenen zufälligen Schlüssel eintragen. Nicht öffentlich speichern.
SESSION_SECRET=


# WICHTIGE KONFIGURATION: E-Mail-Versand
# Zugangsdaten des verwendeten E-Mail-Kontos eintragen.
MAIL_USER=
MAIL_PASSWORD=
PRODUCTION_EMAIL=

# WICHTIGE KONFIGURATION: PayPal
# Zugangsdaten der eigenen PayPal-Anwendung eintragen.
# Für die lokale Entwicklung wird die Sandbox verwendet.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com